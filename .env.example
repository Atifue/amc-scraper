# Required for the Discord bot
DISCORD_TOKEN=
# Channel that receives the daily showtimes post
DISCORD_CHANNEL_ID=
# Optional: sync slash commands to one server instantly while developing
DISCORD_GUILD_ID=

# Daily post time in TIMEZONE (24-hour HH:MM)
POST_TIME=09:00
TIMEZONE=America/New_York

# Optional AMC developer vendor key. If set, showtimes are fetched from
# api.amctheatres.com instead of the public listings fallback.
AMC_VENDOR_KEY=

# Optional: skip cached listings (mostly useful while debugging)
# AMC_CACHE_TTL_SECONDS=300

# Watch only this theater for any newly listed showtimes (Discord ping).
# Fresh Meadows and Bay Terrace stay on /showtimes, /coming, and the daily post.
WATCH_THEATRE=lincoln-square
WATCH_INTERVAL_SECONDS=60
